# Ground API configuration example.
#
# Copy to `.env` for local use (never commit real secrets) and export the
# variables, or pass them to Docker Compose.  The application reads plain
# environment variables; it does not parse .env files itself.

# development | test | production
APP_ENV=development

# PostgreSQL connection string.  The psycopg 3 driver is required.
DATABASE_URL=postgresql+psycopg://ground:ground@127.0.0.1:5432/astronaut_health

# REQUIRED outside demo/development.  Use at least 32 random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# When unset in development, an ephemeral per-process secret is generated, so
# demo tokens stop working after a restart.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=3600
JWT_ISSUER=crew-health-ground-api

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional path override for the canonical DDL file (defaults to the
# repository's schema.sql).
SCHEMA_SQL_PATH=

# Apply schema.sql automatically at startup when the schema is absent.
# Prefer `alembic upgrade head` (or `python -m app.cli init-db`) instead.
AUTO_APPLY_SCHEMA=false

# Seed the deterministic synthetic demo mission/users on startup.
# Seeding refuses to run when APP_ENV=production.
SEED_ON_STARTUP=false

# Enables POST /auth/demo-token.  Disable in any real deployment.
DEMO_SEED_ENABLED=true

# Contact/freshness thresholds, in seconds.
CONTACT_RECENT_SECONDS=900
CONTACT_STALE_SECONDS=3600
FRESHNESS_CURRENT_SECONDS=3600
FRESHNESS_DELAYED_SECONDS=21600

# Connection pool sizing for the API process.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
